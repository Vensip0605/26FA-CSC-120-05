{"text":"#include <iostream>\n#include <string>\nusing namespace std;\n\nint main()\n{\n    cout << \"==========================\\n\";\n    cout << \"   Base Conversion program\\n\";\n    cout << \"=========================\\n\";\n    cout << \"1. Convert Binary to Decimal\\n\";\n    cout << \"2. Convert Decimal to Binary\\n\";\n    cout << \"3. Exit\\n\";\n    cout << \"----------------------------\\n\";\n\n    int choice;\n    cout << \"Enter your choice (1-3): \";\n    cin >> choice;\n\n    if (choice == 1)\n    {\n        string binary;\n        cout << \"Enter a binary number: \";\n        cin >> binary;\n        if (binary find_not_of)\n    }\n    else if (choice == 2)\n    {\n        cout << \"Decimal to Binary\" << endl;\n    }\n    else if (choice == 3)\n    {\n        cout << \"goodbye\" << endl;\n    }\n    else\n    {\n        cout << \"error message\" << endl;\n    }\n}\n","version":1,"path":"base.cpp","snapshot":true,"doc":1,"seq":2,"ms":-5448,"op":"snap"}
