{"text":"#include <iostream>\n\nusing namespace std;\nvoid logActivity(double miles, double &calories, int &minutes)\n{\n    calories = miles * 100;\n    minutes = miles * 10;\n}\n\nvoid logActivity(int steps, double &calories, int &minutes)\n{\n    calories = steps/ * 100;\n    minutes = calories * 20;\n}\n\nint main()\n{\n    double calories = 0.0;\n    int minutes = 0;\n    logActivity(2.5, calories, minutes);\n    cout << \"Burned \" << calories << \" calories in \" << minutes << \" minutes.\\n\";\n    logActivity(3500, calories, minutes);\n    cout << \"Burned \" << calories << \" calories in \" << minutes << \" minutes.\\n\";\n}\n","version":101,"snapshot":true,"doc":2,"seq":124,"ms":802931,"op":"edit"}
